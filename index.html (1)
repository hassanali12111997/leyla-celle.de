<style>
:root{
    --background:#3A0D0D;
    --background2:#4A1111;
    --card:#5A1717;
    --gold:#D9A441;
    --gold-light:#F4C65D;
    --cream:#FFF8E7;
    --muted:#E6D5B8;
    --border:rgba(255,255,255,.12);
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:var(--background);
    color:var(--cream);
    line-height:1.6;
}

header{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(58,13,13,.96);
    border-bottom:1px solid var(--border);
    backdrop-filter:blur(8px);
}

nav{
    max-width:1150px;
    margin:auto;
    padding:15px 20px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.logo{
    color:var(--gold-light);
    font-size:25px;
    font-weight:bold;
}

nav a{
    color:var(--cream);
    text-decoration:none;
    margin-left:18px;
    font-size:14px;
}

nav a:hover{
    color:var(--gold-light);
}

.hero{
    min-height:78vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:80px 20px;
    background:
        radial-gradient(circle at center,rgba(217,164,65,.16),transparent 45%),
        linear-gradient(135deg,var(--background),var(--background2));
}

.hero-content{
    max-width:850px;
}

.badge{
    display:inline-block;
    border:1px solid var(--gold);
    color:var(--gold-light);
    padding:7px 15px;
    border-radius:30px;
    margin-bottom:20px;
    font-size:14px;
}

h1{
    font-size:clamp(38px,7vw,72px);
    line-height:1.05;
    margin-bottom:20px;
}

.hero p{
    color:var(--muted);
    font-size:20px;
    max-width:700px;
    margin:0 auto 30px;
}

.buttons{
    display:flex;
    justify-content:center;
    gap:12px;
    flex-wrap:wrap;
}

.btn{
    display:inline-block;
    padding:13px 22px;
    border-radius:8px;
    text-decoration:none;
    font-weight:bold;
    transition:.2s;
}

.btn-primary{
    background:var(--gold);
    color:#351010;
}

.btn-primary:hover{
    background:var(--gold-light);
}

.btn-secondary{
    border:1px solid var(--gold);
    color:var(--cream);
}

.btn-secondary:hover{
    background:rgba(217,164,65,.12);
}

section{
    max-width:1150px;
    margin:auto;
    padding:75px 20px;
}

.section-title{
    text-align:center;
    margin-bottom:45px;
}

.section-title h2{
    color:var(--gold-light);
    font-size:38px;
    margin-bottom:10px;
}

.section-title p{
    color:var(--muted);
}

.grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
}

.card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:15px;
    padding:28px;
}

.card h3{
    color:var(--gold-light);
    margin-bottom:10px;
}

.card p{
    color:var(--muted);
}

.menu{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:20px;
}

.menu-item{
    display:flex;
    justify-content:space-between;
    gap:20px;
    padding:20px;
    background:var(--card);
    border:1px solid var(--border);
    border-radius:12px;
}

.menu-item h3{
    color:var(--cream);
}

.menu-item p{
    color:var(--muted);
    font-size:14px;
}

.price{
    color:var(--gold-light);
    font-weight:bold;
    white-space:nowrap;
}

.contact{
    text-align:center;
    background:var(--background2);
    max-width:none;
}

.contact-inner{
    max-width:900px;
    margin:auto;
    padding:0 20px;
}

.contact-info{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
    margin:30px 0;
}

.contact-box{
    background:var(--card);
    padding:25px;
    border-radius:12px;
    border:1px solid var(--border);
}

.contact-box strong{
    display:block;
    color:var(--gold-light);
    margin-bottom:8px;
}

.contact-box a{
    color:var(--cream);
    text-decoration:none;
}

footer{
    text-align:center;
    padding:30px 20px;
    color:var(--muted);
    border-top:1px solid var(--border);
}

footer a{
    color:var(--gold-light);
    text-decoration:none;
}

@media(max-width:800px){

    nav{
        flex-direction:column;
        gap:8px;
    }

    nav a{
        margin:0 7px;
        font-size:13px;
    }

    .grid{
        grid-template-columns:1fr;
    }

    .menu{
        grid-template-columns:1fr;
    }

    .contact-info{
        grid-template-columns:1fr;
    }

    section{
        padding:55px 16px;
    }
}
</style>
</head>

